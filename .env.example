# Copy this file to .env.local and paste in the values from your Firebase
# project: console.firebase.google.com -> Project settings -> General ->
# "Your apps" -> Web app -> SDK setup and configuration -> Config.
#
# These are not secrets. A Firebase web config is designed to ship inside the
# browser bundle; access is controlled by firestore.rules plus signing in.
# .env.local is gitignored only to keep project ids out of the repo.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
